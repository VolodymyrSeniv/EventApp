<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.EventDetailPage"
             xmlns:viewmodel="clr-namespace:MauiApp1.ViewModels"
             x:DataType="viewmodel:EventDetailViewModel"
             Title="Event Details"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Image Source="{Binding Eventik.ImageUrl}"
                   HeightRequest="250"
                   Aspect="AspectFill" />

            <Border Margin="0,-30,0,0"
                    Padding="20"
                    StrokeThickness="0"
                    BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30,30,0,0" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-5" Opacity="0.1" Radius="10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding Event.Title}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📅" VerticalOptions="Center" />
                        <Label Text="{Binding Eventik.Date, StringFormat='{0:MMMM dd, yyyy}'}" 
                               VerticalOptions="Center" TextColor="Gray" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📍" VerticalOptions="Center" />
                        <Label Text="{Binding Eventik.Location}" 
                               VerticalOptions="Center" TextColor="Gray" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,5" />

                    <Label Text="About this event" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding Eventik.Description}" 
                           LineHeight="1.2"
                           FontSize="16" />

                    <Button Text="Join Event"
                            Margin="0,20"
                            CornerRadius="25"
                            HeightRequest="50"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>