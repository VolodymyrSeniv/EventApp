<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiAppB.Models"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:viewmodel="clr-namespace:MauiAppB.ViewModels"
             x:DataType="viewmodel:GroupDetailsViewModel"
             ios:Page.UseSafeArea="False"
             x:Class="MauiAppB.Views.GroupDetailsPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <models:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Image Source="bg_main.png" Aspect="AspectFill" />

        <Grid RowDefinitions="Auto, *">

            <Grid Grid.Row="0" Margin="20, 15, 20, 0" HeightRequest="40">
                <Border HeightRequest="40" WidthRequest="40" BackgroundColor="#80FFFFFF" HorizontalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <ImageButton Source="powrot.png" Padding="10" Clicked="OnBackClicked" BackgroundColor="Transparent"/>
                </Border>

                <Label Text="{Binding Groupka.Name}" FontSize="20" FontAttributes="Bold" TextColor="Black"
                       HorizontalOptions="Center" VerticalOptions="Center"/>

                <Border HeightRequest="40" WidthRequest="40" BackgroundColor="#80FFFFFF" HorizontalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <ImageButton Source="settings.png" Padding="10" Clicked="OnSettingsClicked" BackgroundColor="Transparent"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <RefreshView Command="{Binding LoadEventsCommand}" 
                             IsRefreshing="{Binding IsRefreshing}">

                    <CollectionView x:Name="EventsCollection" 
                                    ItemsSource="{Binding GroupEvents}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnEventSelected">

                        <CollectionView.Header>
                            <Label Text="Nadchodzące wydarzenia" Margin="20,10" FontAttributes="Bold" TextColor="Black"/>
                        </CollectionView.Header>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Event">
                                <Border Margin="15, 10, 15, 5" StrokeThickness="0" BackgroundColor="#95FFFFFF">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15"/>
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Padding="15" Spacing="8">
                                        <Border StrokeShape="RoundRectangle 10" HeightRequest="180" StrokeThickness="0">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                                        </Border>

                                        <Grid ColumnDefinitions="*, Auto" Margin="0, 5, 0, 0">
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                                <Label Text="🕒" FontSize="14" TextColor="Gray"/>
                                                <Label Text="{Binding Time}" FontSize="14" TextColor="Black"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="📍" FontSize="14"/>
                                            <Label Text="{Binding Location}" FontSize="14" TextColor="#555555" FontAttributes="Bold"/>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Description}" FontSize="14" TextColor="#333333" MaxLines="2"/>

                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0, 10, 0, 5"  
                                              IsVisible="{Binding IsActionButtonsVisible}">
                                            <Button Text="Będę" BackgroundColor="#D0D0D0" TextColor="Black" CornerRadius="20" Clicked="OnDecisionClicked"/>
                                            <Button Grid.Column="1" Text="Nie będę" BackgroundColor="#D0D0D0" TextColor="Black" CornerRadius="20" Clicked="OnDecisionClicked"/>
                                        </Grid>

                                        <VerticalStackLayout IsVisible="{Binding IsActionButtonsVisible, Converter={x:StaticResource InvertedBoolConverter}}" 
                                                             Spacing="5" HorizontalOptions="Center">
                                            <Label Text="Odpowiedź zapisana" TextColor="Gray" FontSize="12" HorizontalOptions="Center"/>
                                            <Button Text="Zmień" BackgroundColor="#E0E0E0" TextColor="Black" CornerRadius="20" HeightRequest="35" Clicked="OnChangeDecisionClicked"/>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <Border HeightRequest="60" WidthRequest="60" BackgroundColor="White"
                        VerticalOptions="End" HorizontalOptions="End" Margin="25" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.3"/>
                    </Border.Shadow>
                    <ImageButton Source="plus.png" Padding="15" Clicked="OnCreateEventClicked" BackgroundColor="Transparent"/>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsOverlay" IsVisible="False" BackgroundColor="#40000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseSettingsClicked"/>
            </Grid.GestureRecognizers>

            <Border BackgroundColor="#E5E5EA" WidthRequest="220" HorizontalOptions="End" VerticalOptions="Start" Margin="0, 90, 20, 0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="0">
                    <Button Text="Edytuj grupę" 
                            TextColor="#007AFF" 
                            BackgroundColor="Transparent" 
                            FontSize="16"
                            HeightRequest="50"
                            Clicked="OnUpdateGroupClicked"/>

                    <BoxView HeightRequest="0.5" Color="Gray" Opacity="0.3" Margin="15,0"/>

                    <Button Text="Usuń i opuść grupę" 
                            TextColor="#FF3B30" 
                            BackgroundColor="Transparent" 
                            FontSize="16"
                            HeightRequest="50"
                            Command="{Binding DeleteGroupCommand}"
                            CommandParameter="{Binding Groupka.Id}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>