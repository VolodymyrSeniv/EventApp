<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="False"
             x:Class="MauiAppB.Views.ProfilePage"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Image Source="bg_main.png" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill"/>

        <Grid RowDefinitions="Auto, Auto, *">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" Margin="20, 50, 20, 0" HeightRequest="50">
                <Frame Grid.Column="0" HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" BackgroundColor="#80FFFFFF" BorderColor="Transparent" HasShadow="False">
                    <ImageButton Source="powrot.png" Padding="12" Clicked="OnBackClicked"/>
                </Frame>
                <Frame Grid.Column="2" HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" BackgroundColor="#80FFFFFF" BorderColor="Transparent" HasShadow="False" Margin="0,0,10,0">
    <ImageButton Source="edytuj.png" Padding="10" Clicked="OnEditClicked"/> 
</Frame>
                <Frame Grid.Column="3" HeightRequest="40" WidthRequest="40" CornerRadius="20" Padding="0" BackgroundColor="#80FFFFFF" BorderColor="Transparent" HasShadow="False">
                    <ImageButton Source="settings.png" Padding="10"/>
                </Frame>
            </Grid>

            <Border Grid.Row="1" 
                    Margin="20, 20, 20, 30" 
                    Padding="20, 25"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30"
                    BackgroundColor="#99FFFFFF">
                
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Frame HeightRequest="120" WidthRequest="120" CornerRadius="60" Padding="0" IsClippedToBounds="True" BorderColor="Transparent" HorizontalOptions="Center" BackgroundColor="#E0E0E0">
                        <Image Source="{Binding PhotoUrl}" Aspect="AspectFill"/>
                    </Frame>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0, 5, 0, 0">
                        <Label Text="{Binding FirstName}" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="Black"/>
                        <Label Text="{Binding LastName}" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="Black"/>
                    </HorizontalStackLayout>
                
                    <Label Text="{Binding Status}" 
                           FontSize="14" 
                           TextColor="#404040" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="2" 
                    BackgroundColor="#F5F5F5" 
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30,30,0,0" 
                    VerticalOptions="Fill"
                    Margin="0,0,0,0">
                
                <ScrollView>
                    <VerticalStackLayout Padding="30" Spacing="25">
                        
                        <Label Text="Info" FontSize="16" FontAttributes="Bold" TextColor="Black"/>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding PhoneNumber}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                            <Label Text="Numer telefonu" FontSize="12" TextColor="Gray"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Bio}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                            <Label Text="O mnie" FontSize="12" TextColor="Gray"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Username}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                            <Label Text="Nazwa użytkownika" FontSize="12" TextColor="Gray"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

        </Grid>
    </Grid>
</ContentPage>