<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:viewmodels="clr-namespace:MauiAppB.ViewModels"
             ios:Page.UseSafeArea="False"
             x:Class="MauiAppB.Views.CreateGroupPage"
             x:DataType="viewmodels:GroupListViewModel"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Image Source="bg_main.png" Aspect="AspectFill" />

        <ScrollView>
            <Grid RowDefinitions="Auto, Auto, *" Padding="20, 30, 20, 20" RowSpacing="20">

                <Border Grid.Row="0" HeightRequest="40" WidthRequest="40" 
                        HorizontalOptions="Start" BackgroundColor="#80FFFFFF" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <ImageButton Source="powrot.png" Padding="10" Clicked="OnBackClicked" BackgroundColor="Transparent"/>
                </Border>

                <Label Grid.Row="1" Text="{Binding PageTitle}" FontSize="40" TextColor="Black" FontAttributes="Bold" Margin="0, 10, 0, 10"/>

                <VerticalStackLayout Grid.Row="2" Spacing="15">

                    <Border Stroke="Black" StrokeThickness="1" BackgroundColor="#80FFFFFF" HeightRequest="150">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRectangle="15"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPhotoClicked"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                                <Label Text="📷" FontSize="24" HorizontalOptions="Center"/>
                                <Label Text="Dodaj zdjęcie" FontSize="14" TextColor="Black" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <Image x:Name="GroupImagePreview" Aspect="AspectFill" IsVisible="False" IsClippedToBounds="True"/>
                        </Grid>
                    </Border>

                    <Border Stroke="Black" StrokeThickness="1" BackgroundColor="White" HeightRequest="55" Padding="15,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry x:Name="GroupNameEntry" 
                               Text="{Binding NewGroupName}"
                               Placeholder="Nazwa grupy" 
                               PlaceholderColor="Gray" 
                               TextColor="Black" 
                               VerticalOptions="Center"/>
                    </Border>

                    <BoxView HeightRequest="1" Color="Gray" Opacity="0.3" Margin="0, 5"/>

                    <Label Text="Dodaj uczestników" FontSize="16" FontAttributes="Bold" TextColor="Black"/>

                    <Grid ColumnDefinitions="*, 50" ColumnSpacing="10">
                        <Border Grid.Column="0" Stroke="Black" StrokeThickness="1" BackgroundColor="White" HeightRequest="50" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry x:Name="UsernameEntry" Placeholder="Username (np. @anna)" PlaceholderColor="Gray" TextColor="Black" VerticalOptions="Center"/>
                        </Border>
                        <Button Grid.Column="1" Text="+" FontSize="24" TextColor="White" BackgroundColor="Black" CornerRadius="10" Clicked="OnAddMemberClicked"/>
                    </Grid>

                    <VerticalStackLayout x:Name="MembersStack" Spacing="10" />

                    <Button Text="{Binding ButtonText}" 
                            Command="{Binding AddGroupCommand}"
                            BackgroundColor="Black" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="25" 
                            HeightRequest="50" 
                            Margin="0, 20, 0, 50" />

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>